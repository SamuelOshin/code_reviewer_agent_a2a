# Copy to .env and fill in. Every variable here is read by app/core/config.py
# (or app/services/github_mcp.py for SKIP_GITHUB_CONNECTION_TEST).

# ============================================
# Application Configuration
# ============================================
# development, staging, production. Docs endpoints are only served in development.
ENVIRONMENT=development

# ============================================
# Server Configuration
# ============================================
# Used when running `python -m app.main`. In Docker the port is fixed at 8000.
PORT=8000
# Host port Docker Compose publishes; change it if 8000 is already in use
# HOST_PORT=8000

# ============================================
# GitHub Configuration (both required)
# ============================================
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
# Required: startup fails if empty. Use the same value in the GitHub webhook settings.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=your_random_webhook_secret_here

# ============================================
# API access (required)
# ============================================
# Callers of /rpc and /a2a/* send "Authorization: Bearer <API_KEY>". At least 32
# characters; startup fails otherwise. This placeholder is public: replace it.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=replace_with_a_long_random_api_key_0123456789

# Hosts allowed to receive A2A push notifications (pushNotificationConfig.url),
# comma-separated bare hostnames, exact match. Empty disables push notifications.
# Push URLs must also be https and resolve to public IP addresses.
# PUSH_URL_ALLOWED_HOSTS=hooks.example.com

# Browser origins allowed by CORS, comma-separated scheme://host[:port].
# Empty sends no CORS headers (fine for server-to-server clients). "*" is refused.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Most calls accepted in one JSON-RPC batch (1-100)
# JSONRPC_MAX_BATCH_SIZE=10
# Optional: skip the GitHub connection test on slow networks
# SKIP_GITHUB_CONNECTION_TEST=true

# ============================================
# LLM Configuration
# ============================================
# Provider and model are configuration only: LLM_MODEL=<provider>:<model-id>
# Providers: google, openai, anthropic, openai-compatible
# Model IDs checked against vendor docs on 2026-11-12. Examples:
#   google:gemini-3.8-flash        google:gemini-3.5-flash-lite
#   openai:gpt-6.1-sol             openai:gpt-6-luna
#   anthropic:claude-sonnet-5-5    anthropic:claude-haiku-5-5
#   openai-compatible:<id>         (needs OPENAI_COMPATIBLE_BASE_URL)
# The default is provisional until evals pick one (tracker decision D-13).
LLM_MODEL=google:gemini-3.8-flash

# Optional: a different model per role (empty uses LLM_MODEL)
# LLM_MODEL_SECURITY=anthropic:claude-sonnet-5-5
# LLM_MODEL_PERFORMANCE=
# LLM_MODEL_BEST_PRACTICES=
# LLM_MODEL_SUMMARY=google:gemini-3.5-flash-lite

# Optional: comma-separated models to try in order if a call fails
# LLM_FALLBACK_MODELS=openai:gpt-6.1-sol,anthropic:claude-sonnet-5-5

# Structured output: auto (native schema where supported), native, tool or prompted
# LLM_STRUCTURED_OUTPUT_MODE=auto
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4000
# Retries for transient provider errors, and per-request timeout in seconds
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=120

# Keys: only the providers your models use are needed
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Any OpenAI Chat Completions compatible server (local models, gateways)
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_API_KEY=

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
