diff --git a/src/main/java/shop/OrderRepository.java b/src/main/java/shop/OrderRepository.java
--- a/src/main/java/shop/OrderRepository.java
+++ b/src/main/java/shop/OrderRepository.java
@@ -0,0 +1,20 @@
+package shop;
+
+import java.sql.Connection;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.sql.Statement;
+
+public class OrderRepository {
+    private final Connection connection;
+
+    public OrderRepository(Connection connection) {
+        this.connection = connection;
+    }
+
+    public ResultSet findByReference(String reference) throws SQLException {
+        String sql = "SELECT * FROM orders WHERE reference = '" + reference + "'";
+        Statement statement = connection.createStatement();
+        return statement.executeQuery(sql);
+    }
+}