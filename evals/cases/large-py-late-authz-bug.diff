diff --git a/reports/admin_actions.py b/reports/admin_actions.py
--- a/reports/admin_actions.py
+++ b/reports/admin_actions.py
@@ -0,0 +1,10 @@
+from reports.store import reports
+
+
+def delete_report(current_user, report_id):
+    """Delete a report on behalf of the signed-in user."""
+    report = reports.get(report_id)
+    if current_user is None:
+        raise PermissionError("sign in first")
+    reports.delete(report.id)
+    return {"deleted": report.id}